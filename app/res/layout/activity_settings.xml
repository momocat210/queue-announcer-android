<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/txt"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 角色 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="本机角色" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbServer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="服务器端"
                android:textColor="@color/txt"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbCaller"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="叫号端"
                android:textColor="@color/txt"
                android:textSize="14sp" />
        </RadioGroup>

        <!-- 蓝牙组网 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="蓝牙组网（两台手机之间）" />

        <TextView
            android:id="@+id/tvLinkState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="未连接"
            android:textColor="@color/txtDim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickPeer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="选择对方手机"
            android:textColor="@color/txt"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="两机需先在系统蓝牙中配对。服务器端只负责等待连接，无需选择。"
            android:textColor="@color/txtDim2"
            android:textSize="11sp" />

        <!-- 打印机 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="喵喵机（服务器端打印号单）" />

        <TextView
            android:id="@+id/tvPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未选择打印机"
            android:textColor="@color/txtDim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPickPrinter"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:text="选择打印机"
                android:textColor="@color/txt"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnTestPrint"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:text="打印测试页"
                android:textColor="@color/teal"
                android:textSize="14sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/swAutoPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="取号后自动打印号单"
            android:textColor="@color/txt"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/swPrinterCompat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="兼容模式（不发送校验密钥）"
            android:textColor="@color/txt"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="打印空白或报错时，先试「兼容模式」再试自检页；不支持喵喵机的打印机无法使用。"
            android:textColor="@color/txtDim2"
            android:textSize="11sp" />

        <!-- 播报 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="由哪台手机播报" />

        <RadioGroup
            android:id="@+id/rgBroadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBsServer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="服务器端"
                android:textColor="@color/txt"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbBsCaller"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="叫号端"
                android:textColor="@color/txt"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbBsBoth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="两端都播"
                android:textColor="@color/txt"
                android:textSize="13.5sp" />
        </RadioGroup>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="播报内容（{num} 为号码）" />

        <EditText
            android:id="@+id/etTemplate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="请{num}号办理业务"
            android:inputType="text"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/txt"
            android:textColorHint="@color/txtDim2"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etExtra"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="附加一句，如：请到 2 号窗口（可留空）"
            android:inputType="text"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="@color/txt"
            android:textColorHint="@color/txtDim2"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStart"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="起始号"
                android:inputType="number"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/txt"
                android:textColorHint="@color/txtDim2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnResetQueue"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:text="重置队列"
                android:textColor="#FF9A9A"
                android:textSize="13.5sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="号码位数" />

        <RadioGroup
            android:id="@+id/rgDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbD2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2 位"
                android:textColor="@color/txt"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbD3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 位"
                android:textColor="@color/txt"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbD4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4 位"
                android:textColor="@color/txt"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="数字读法" />

        <RadioGroup
            android:id="@+id/rgRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbReadDigit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="逐位读：零零一"
                android:textColor="@color/txt"
                android:textSize="13.5sp" />

            <RadioButton
                android:id="@+id/rbReadValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="按数值：一号"
                android:textColor="@color/txt"
                android:textSize="13.5sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvRateLabel"
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="语速 0.95" />

        <SeekBar
            android:id="@+id/sbRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="80"
            android:progress="35"
            android:progressTint="@color/teal"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/tvVolLabel"
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="音量 100%" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/teal"
            android:thumbTint="#FFFFFF" />

        <Switch
            android:id="@+id/swChime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="播报前播放「叮咚」提示音"
            android:textColor="@color/txt"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/swAwake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="屏幕保持常亮"
            android:textColor="@color/txt"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="语音引擎检测中…"
            android:textColor="@color/txtDim2"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPreview"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:text="试听"
                android:textColor="@color/tealDark"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDefaults"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:text="恢复默认"
                android:textColor="@color/txtDim"
                android:textSize="14.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
