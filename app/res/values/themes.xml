<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/bgDark</item>
        <item name="android:navigationBarColor">@color/bgDark</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/bgDark</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/txtDim</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
